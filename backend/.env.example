# Copy this file to .env and adjust. Never commit the real .env.

# ---------------------------------------------------------------- Server
PORT=3000
# Number of proxies in front of the backend, so rate limiting sees the real visitor.
# Leave empty for local runs without nginx. 1 = nginx only, 2 = load balancer + nginx.
TRUST_PROXY=

# ---------------------------------------------------------------- Database
# Leave empty to use the in-memory store (easiest way to try the app; data is lost
# on restart). Set it to use PostgreSQL; tables are created automatically.
# Example: postgres://jaanch:jaanch@localhost:5432/jaanch
DATABASE_URL=
# Set to true for Amazon RDS (turns on SSL). Do not also put ?sslmode= in the URL.
PG_SSL=false

# ---------------------------------------------------------------- Scan queue
# The worker runs inside the API process. Set false to run API only.
WORKER_ENABLED=true
# Scans processed at the same time. Keep at 1 or 2: Chrome uses a lot of memory.
MAX_CONCURRENT_SCANS=1
# Time limit for the health checks (Lighthouse, accessibility, links) per scan.
SCAN_TIMEOUT_MS=120000
# Re-use a finished result for the same URL for this many minutes.
SCAN_CACHE_MINUTES=30
# Max links checked per scan for the broken-link report.
MAX_LINKS_TO_CHECK=25

# ---------------------------------------------------------------- Abuse protection
# Requests to create scans allowed per IP in the window below.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MIN=15
# DEV ONLY. true lets the scanner open localhost / private network addresses and
# non-standard ports, so you can test against your own local sites. Never enable
# this on a public deployment: it turns off the SSRF protection.
ALLOW_PRIVATE_TARGETS=false

# ---------------------------------------------------------------- Trust check sources
# Google Safe Browsing API key (free). Without it that check is skipped.
SAFE_BROWSING_API_KEY=
# OpenPhish community feed (downloads a public list of phishing URLs, cached in memory).
OPENPHISH_ENABLED=true
OPENPHISH_REFRESH_HOURS=12

# Domain registration dates come from each registry's own RDAP server (found via the IANA list).
# These only need changing for testing.
# RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
# RDAP_BASE=https://rdap.org/domain/

# ---------------------------------------------------------------- Browser (Lighthouse, Playwright)
# Path to Chrome or Chromium. Leave empty to auto-detect an installed Chrome.
# Examples:  macOS  /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#            Linux  /usr/bin/chromium
#            Windows  C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
# Needed when Chrome runs as root or inside a container. Turned on automatically for root.
CHROME_NO_SANDBOX=false

# ---------------------------------------------------------------- AI explanation
# ollama  = local open-source model (no API key)
# bedrock = Amazon Bedrock (cloud)
# none    = skip the LLM, show a rule-based summary only
LLM_PROVIDER=ollama
LLM_TIMEOUT_MS=90000

OLLAMA_URL=http://localhost:11434
# Use llama3.2:3b on low-RAM laptops. Test Hindi quality before choosing.
OLLAMA_MODEL=gemma2:9b

# Region where you enabled the model, and the model or inference profile id from the
# Bedrock console. Credentials come from the normal AWS credential chain.
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=

# ---------------------------------------------------------------- Report files (screenshots)
# Leave empty to store screenshots on local disk (./data/screenshots).
# Set a bucket name to store them in Amazon S3 instead.
S3_BUCKET=
S3_REGION=

# --- AI second opinion and accounts (all optional) ---
# The AI reads the page wording and can only ADD caution to a verdict, never make it safer. Set to false to turn off.
# AI_REVIEW=true
# AI_REVIEW_TIMEOUT_MS=25000
# Accounts: use a long random value (for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Without it, logins reset every time the server restarts.
# SESSION_SECRET=
# SESSION_DAYS=30
# Set true when the site is served over HTTPS (it makes the login cookie HTTPS-only).
# COOKIE_SECURE=false
